# secrets: these pair this machine with the TV, never commit
cert.pem
key.pem
*.pem
# signing keys of the Android apps: whoever has them can publish updates under the apps' names
*.jks
# this machine's own data and downloads
tvs.json
tvs.json.tmp
venv/
tools/
.cache/
__pycache__/
*.log
.DS_Store
# build output
app/*/build/
app/gradle/.gradle/
app/gradle/.kotlin/
app/gradle/build/
app/gradle/local.properties
.idea/
# APKs are attached to releases, never committed
app/android/*.apk
app/tv/*.apk
app/home/*.apk
app/channels/*.apk
app/games/*.apk
*.tvrkeys

# dev/test/layout.js: Playwright, installed with npm install --prefix dev playwright
dev/node_modules/
dev/package.json
dev/package-lock.json
