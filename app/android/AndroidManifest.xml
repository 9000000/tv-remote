<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.tvremote.phone">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />   <!-- installing its own update -->
    <application android:label="TV Remote" android:icon="@drawable/icon"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="true">   <!-- the in-app page is served from 127.0.0.1 -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
