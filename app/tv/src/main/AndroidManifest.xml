<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />   <!-- sees Tailscale's VPN go down (TailscaleWatch), and the Wi-Fi (Stats) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />      <!-- the Wi-Fi signal, for the History view (Stats) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />   <!-- the chip kept up while the TV is off, when asked (KeepAwake) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />   <!-- "Remove TV Setup" without ADB: Android's own uninstall prompt -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />   <!-- drawing over the screen (DrawLayer); allowed through ADB -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />   <!-- ADB debugging back on when switched off (KeepAdb); granted through ADB -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />   <!-- which app is on screen, for the History view; granted through ADB -->
    <queries>                                                          <!-- to list the apps on the TV's home screen -->
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <package android:name="com.tailscale.ipn" />                  <!-- its updates, to switch it back on (TailscaleWatch) -->
    </queries>
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:name=".SetupApp" android:label="TV Setup" android:icon="@drawable/icon" android:banner="@drawable/banner"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar" android:allowBackup="false" android:networkSecurityConfig="@xml/net">
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- the web UI on the TV itself (RemoteService's page, let in by a pass only this process has) -->
        <activity android:name=".ManageActivity" android:exported="false" android:process=":web" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />
        <!-- PairActivity and WarnActivity: started by this app and by the shell (am start over ADB: DUMP is held by the shell only), never by another app -->
        <activity android:name=".PairActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true" android:launchMode="singleTop" />
        <!-- the sleep timer, bedtime and app limits warn over whatever is on screen; started through the TV's ADB (Guard.kt) -->
        <activity android:name=".WarnActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true" android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:noHistory="true" />
        <!-- the launcher gallery: "Keep this launcher?" and the notice that the TV went back to its own; started through the TV's ADB (LauncherGuard.kt, LauncherInstall) -->
        <activity android:name=".LauncherConfirmActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true" android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:noHistory="true" />
        <!-- started by the shell too (DUMP: no app can), when a receiver may not start it from the background: RulesClient, SetupUpdate -->
        <service android:name=".RemoteService" android:exported="true" android:permission="android.permission.DUMP" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="web remote control served on the local network" />
        </service>
        <!-- hands a TV Setup pass to a device that already has ADB; DUMP is held by the shell only, so no app can ask -->
        <receiver android:name=".TrustReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- timers and limits for a device that has ADB here (RulesClient.kt); held by the shell only, like the one above -->
        <receiver android:name=".RulesReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- drawing over the screen for a device that has ADB here (DrawLayer.kt, Draw.kt) -->
        <receiver android:name=".DrawReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- a message in a corner of the screen for a device that has ADB here (NotifyLayer.kt, Notify.kt) -->
        <receiver android:name=".NotifyReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- the welcome screen (Welcome.kt): set up by a device that has ADB here; held by the shell only, like the ones above -->
        <receiver android:name=".WelcomeReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <!-- full screen over everything when the TV is turned on; started by this app, and by the shell (am start) -->
        <activity android:name=".WelcomeActivity" android:exported="true" android:permission="android.permission.DUMP" android:excludeFromRecents="true"
            android:launchMode="singleTask" android:taskAffinity="" android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />   <!-- after this app updates itself -->
            </intent-filter>
        </receiver>
    </application>
</manifest>
