<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />               <!-- the weather card (Weather: Open-Meteo, the place from the internet address) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />   <!-- Wi-Fi, cable or offline on the network button -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />      <!-- the Wi-Fi signal on the system card (Widgets) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />   <!-- the Wi-Fi's name on the network button: granted over ADB only (HomeConfig.GRANT_WIFI) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" /> <!-- Android 12+ wants it beside FINE -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />   <!-- only ever granted over ADB (Dream.kt): the screensaver switch -->
    <queries>                                                         <!-- the apps it lists, and TV Setup for the usage card -->
        <package android:name="dev.tvremote.setup" />
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
    </queries>
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="@string/app_name" android:icon="@drawable/icon" android:banner="@drawable/banner" android:allowBackup="false"
        android:theme="@style/Home" android:supportsRtl="false">
        <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask" android:stateNotNeeded="true"
            android:excludeFromRecents="true" android:clearTaskOnLaunch="true" android:resumeWhilePausing="true" android:directBootAware="true"
            android:screenOrientation="landscape" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- the screensaver: the clock, the date and the wallpaper; chosen in the TV's settings, or by the "screensaver" switch (Dream.kt) -->
        <service android:name=".HomeDream" android:exported="true" android:label="@string/app_name" android:icon="@drawable/icon"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter><action android:name="android.service.dreams.DreamService" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>
        <activity android:name=".DreamSettings" android:exported="true" android:theme="@style/Ghost" android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection" />
        <!-- another app pins a shortcut here (Android 8+): Pins.kt; the request is the system's own object, a forged intent carries none -->
        <activity android:name=".PinActivity" android:exported="true" android:theme="@style/Ghost" android:excludeFromRecents="true"
            android:noHistory="true" android:taskAffinity="">
            <intent-filter><action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" /></intent-filter>
        </activity>
        <!-- its settings, from a phone or computer that has ADB here (core/ontv/Home.kt); DUMP is held by the shell only, so no app can -->
        <receiver android:name=".HomeReceiver" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
