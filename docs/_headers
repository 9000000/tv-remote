/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/lib/*
  Cache-Control: public, max-age=2592000

/home/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/launchers/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# web games: asked again on every open (a 304 when unchanged), so a fixed crash reaches players as soon as it is pushed
/games/web/*
  Cache-Control: no-cache

/games/games.json
  Cache-Control: no-cache

/games/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/games/roms/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/demo/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# the guide for AI agents (dev/gen/guide_md.js): the .md in UTF-8, so a browser or fetch tool shows the Vietnamese right
/guide/*.md
  Content-Type: text/markdown; charset=utf-8
